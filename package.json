{
  "name": "mathcanvas-ai-authoring",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --sort run build",
    "architecture:baseline": "node scripts/architecture/check-core-diff.mjs baseline",
    "architecture:verify": "node scripts/architecture/check-core-diff.mjs verify",
    "test:budget": "node scripts/architecture/check-test-budget.mjs",
    "clean": "pnpm -r run clean",
    "contract:probe:wave1": "node scripts/contract-lab/capture-wave1-round-trip.mjs",
    "contract:probe:wave1:canary": "node scripts/contract-lab/capture-wave1-canary.mjs",
    "contract:recover:wave1:canary": "node scripts/contract-lab/recover-wave1-canary.mjs",
    "contract:probe:wave2:read-only": "node scripts/contract-lab/capture-common-draw-contract.mjs",
    "contract:probe:wave2:canary": "node scripts/contract-lab/capture-wave2-canary.mjs",
    "contract:probe:wave3:static": "node scripts/contract-lab/extract-pen-contract.mjs",
    "contract:probe:wave3:canary": "node scripts/contract-lab/capture-wave3-pen-canary.mjs",
    "contract:probe:wave4:static": "node scripts/contract-lab/extract-module-variant-contract.mjs",
    "contract:probe:p3:canary": "node scripts/contract-lab/capture-p3-release-canary.mjs",
    "contract:probe:w3:optical": "node scripts/contract-lab/capture-w3-equation-rail-optical.mjs",
    "contract:verify:p3:canary": "node scripts/contract-lab/validate-p3-release-canary.mjs",
    "contract:verify": "node scripts/contract-lab/verify.mjs",
    "cognitive:verify": "node scripts/pedagogy/check-cognitive-demand.mjs",
    "doctor": "node scripts/doctor.mjs",
    "golden:verify": "vitest run tests/p0-golden.test.ts",
    "golden:update": "node scripts/golden/update.mjs",
    "smoke:browser": "node scripts/smoke-managed-browser.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm architecture:verify && pnpm test:budget && pnpm typecheck && pnpm test && pnpm build && pnpm cognitive:verify"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "playwright-core": "1.62.0",
    "typescript": "^5.8.3",
    "vite": "^6.1.0",
    "vitest": "^3.1.1"
  }
}
