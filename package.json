{
  "name": "mathcanvas-ai-authoring",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --sort run build",
    "architecture:baseline": "node scripts/architecture/check-core-diff.mjs baseline",
    "architecture:verify": "node scripts/architecture/check-core-diff.mjs verify",
    "test:budget": "node scripts/architecture/check-test-budget.mjs",
    "clean": "pnpm -r run clean",
    "contract:probe:wave1": "node scripts/contract-lab/capture-wave1-round-trip.mjs",
    "contract:probe:wave1:canary": "node scripts/contract-lab/capture-wave1-canary.mjs",
    "contract:recover:wave1:canary": "node scripts/contract-lab/recover-wave1-canary.mjs",
    "contract:probe:wave2:read-only": "node scripts/contract-lab/capture-common-draw-contract.mjs",
    "contract:probe:wave2:canary": "node scripts/contract-lab/capture-wave2-canary.mjs",
    "contract:probe:wave3:static": "node scripts/contract-lab/extract-pen-contract.mjs",
    "contract:probe:wave3:canary": "node scripts/contract-lab/capture-wave3-pen-canary.mjs",
    "contract:probe:wave4:static": "node scripts/contract-lab/extract-module-variant-contract.mjs",
    "contract:probe:wave5:algebra-rod": "node scripts/contract-lab/capture-wave5-algebra-rod-canary.mjs",
    "contract:probe:wave5:equality": "node scripts/contract-lab/capture-wave5-equality-release-canary.mjs",
    "contract:probe:wave5:balance-scale": "node scripts/contract-lab/capture-wave5-balance-scale-release-canary.mjs",
    "contract:probe:wave6:clock": "node scripts/contract-lab/capture-wave6-clock-release-canary.mjs",
    "contract:probe:wave7:elapsed-time": "node scripts/contract-lab/capture-wave7-elapsed-time-release-canary.mjs",
    "contract:probe:wave8:fraction-sum": "node scripts/contract-lab/capture-wave8-fraction-sum-release-canary.mjs",
    "contract:probe:wave9:improper-sum": "node scripts/contract-lab/capture-wave8-fraction-sum-release-canary.mjs --improper",
    "contract:probe:wave10:common-unit": "node scripts/contract-lab/capture-wave8-fraction-sum-release-canary.mjs --common-unit",
    "contract:probe:wave11:common-unit-difference": "node scripts/contract-lab/capture-wave8-fraction-sum-release-canary.mjs --difference",
    "contract:probe:wave12:bar-graph-scale": "node scripts/contract-lab/capture-wave8-fraction-sum-release-canary.mjs --bar-graph",
    "contract:probe:wave13:broken-ruler": "node scripts/contract-lab/capture-wave13-broken-ruler-release-canary.mjs",
    "contract:probe:wave14:place-value-model": "node scripts/contract-lab/capture-wave14-place-value-model-canary.mjs",
    "contract:verify:wave14:place-value-model": "node scripts/contract-lab/validate-wave14-place-value-model-canary.mjs",
    "contract:canary:wave14:place-value": "node scripts/contract-lab/capture-wave14-place-value-release-canary.mjs",
    "contract:canary:wave16-17": "node scripts/contract-lab/capture-wave16-17-release-canaries.mjs",
    "contract:probe:p3:canary": "node scripts/contract-lab/capture-p3-release-canary.mjs",
    "contract:probe:w3:optical": "node scripts/contract-lab/capture-w3-equation-rail-optical.mjs",
    "contract:verify:p3:canary": "node scripts/contract-lab/validate-p3-release-canary.mjs",
    "contract:verify:wave5:equality": "node scripts/contract-lab/validate-activity-release-canary.mjs",
    "contract:verify:wave5:balance-scale": "node scripts/contract-lab/validate-activity-release-canary.mjs --input research/mathcanvas/wave5-balance-scale-release-canary.json",
    "contract:verify:wave6:clock": "node scripts/contract-lab/validate-activity-release-canary.mjs --input research/mathcanvas/wave6-clock-release-canary.json",
    "contract:verify:wave7:elapsed-time": "node scripts/contract-lab/validate-activity-release-canary.mjs --input research/mathcanvas/wave7-elapsed-time-release-canary.json",
    "contract:verify:wave8:fraction-sum": "node scripts/contract-lab/validate-activity-release-canary.mjs --input research/mathcanvas/wave8-fraction-sum-release-canary.json",
    "contract:verify:wave9:improper-sum": "node scripts/contract-lab/validate-activity-release-canary.mjs --input research/mathcanvas/wave9-improper-sum-release-canary.json",
    "contract:verify:wave10:common-unit": "node scripts/contract-lab/validate-activity-release-canary.mjs --input research/mathcanvas/wave10-common-unit-release-canary.json",
    "contract:verify:wave11:common-unit-difference": "node scripts/contract-lab/validate-activity-release-canary.mjs --input research/mathcanvas/wave11-common-unit-difference-release-canary.json",
    "contract:verify:wave12:bar-graph-scale": "node scripts/contract-lab/validate-activity-release-canary.mjs --input research/mathcanvas/wave12-bar-graph-scale-release-canary.json",
    "contract:verify:wave13:broken-ruler": "node scripts/contract-lab/validate-activity-release-canary.mjs --input research/mathcanvas/wave13-broken-ruler-release-canary.json",
    "contract:verify": "node scripts/contract-lab/verify.mjs",
    "cognitive:verify": "node scripts/pedagogy/check-cognitive-demand.mjs",
    "doctor": "node scripts/doctor.mjs",
    "golden:verify": "vitest run tests/p0-golden.test.ts",
    "golden:update": "node scripts/golden/update.mjs",
    "mathcanvas:login": "pnpm --filter @mathcanvas/managed-browser build && node scripts/login-mathcanvas.mjs",
    "release:preview": "node scripts/capture-release-previews.mjs",
    "smoke:browser": "node scripts/smoke-managed-browser.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm architecture:verify && pnpm test:budget && pnpm typecheck && pnpm test && pnpm build && pnpm cognitive:verify"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "playwright-core": "1.62.0",
    "typescript": "^5.8.3",
    "vite": "^6.1.0",
    "vitest": "^3.1.1"
  }
}
